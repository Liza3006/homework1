package hw_7;

import java.util.*;

public class CollectionPerformanceTester {

  public static void main(String[] args) {
    int n = 10000;

    ArrayList<Integer> al1 = new ArrayList<>();
    long start1 = System.currentTimeMillis();
    for (int i = 0; i < n; i++) al1.add(i);
    long time1 = System.currentTimeMillis() - start1;

    LinkedList<Integer> ll1 = new LinkedList<>();
    long start2 = System.currentTimeMillis();
    for (int i = 0; i < n; i++) ll1.add(i);
    long time2 = System.currentTimeMillis() - start2;
    System.out.printf("Добавление в конец\t%d\t\t%d%n", time1, time2);


    ArrayList<Integer> al2 = new ArrayList<>();
    long start3 = System.currentTimeMillis();
    for (int i = 0; i < n; i++) al2.add(0, i);
    long time3 = System.currentTimeMillis() - start3;

    LinkedList<Integer> ll2 = new LinkedList<>();
    long start4 = System.currentTimeMillis();
    for (int i = 0; i < n; i++) ll2.add(0, i);
    long time4 = System.currentTimeMillis() - start4;
    System.out.printf("Добавление в начало\t%d\t\t%d%n", time3, time4);


    ArrayList<Integer> al3 = new ArrayList<>();
    for (int i = 0; i < n; i++) al3.add(i);
    long start5 = System.currentTimeMillis();
    for (int i = 0; i < 1000; i++) al3.add(n/2, i);
    long time5 = System.currentTimeMillis() - start5;

    LinkedList<Integer> ll3 = new LinkedList<>();
    for (int i = 0; i < n; i++) ll3.add(i);
    long start6 = System.currentTimeMillis();
    for (int i = 0; i < 1000; i++) ll3.add(n/2, i);
    long time6 = System.currentTimeMillis() - start6;
    System.out.printf("Вставка в середину\t%d\t\t%d%n", time5, time6);


    ArrayList<Integer> al4 = new ArrayList<>();
    for (int i = 0; i < n; i++) al4.add(i);
    long start7 = System.currentTimeMillis();
    Random r = new Random();
    for (int i = 0; i < 1000; i++) al4.get(r.nextInt(n));
    long time7 = System.currentTimeMillis() - start7;

    LinkedList<Integer> ll4 = new LinkedList<>();
    for (int i = 0; i < n; i++) ll4.add(i);
    long start8 = System.currentTimeMillis();
    for (int i = 0; i < 1000; i++) ll4.get(r.nextInt(n));
    long time8 = System.currentTimeMillis() - start8;
    System.out.printf("Доступ по индексу\t%d\t\t%d%n", time7, time8);


    ArrayList<Integer> al5 = new ArrayList<>();
    for (int i = 0; i < n; i++) al5.add(i);
    long start9 = System.currentTimeMillis();
    while (!al5.isEmpty()) al5.remove(0);
    long time9 = System.currentTimeMillis() - start9;

    LinkedList<Integer> ll5 = new LinkedList<>();
    for (int i = 0; i < n; i++) ll5.add(i);
    long start10 = System.currentTimeMillis();
    while (!ll5.isEmpty()) ll5.remove(0);
    long time10 = System.currentTimeMillis() - start10;
    System.out.printf("Удаление из начала\t%d\t\t%d%n", time9, time10);


    ArrayList<Integer> al6 = new ArrayList<>();
    for (int i = 0; i < n; i++) al6.add(i);
    long start11 = System.currentTimeMillis();
    while (!al6.isEmpty()) al6.remove(al6.size()-1);
    long time11 = System.currentTimeMillis() - start11;

    LinkedList<Integer> ll6 = new LinkedList<>();
    for (int i = 0; i < n; i++) ll6.add(i);
    long start12 = System.currentTimeMillis();
    while (!ll6.isEmpty()) ll6.remove(ll6.size()-1);
    long time12 = System.currentTimeMillis() - start12;
    System.out.printf("Удаление из конца\t%d\t\t%d%n", time11, time12);
  }
}
